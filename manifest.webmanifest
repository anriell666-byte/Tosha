{
  "id": "./",
  "name": "Тоша — тихий помощник",
  "short_name": "Тоша",
  "description": "Ненавязчивые напоминания о еде и движении в формате заботы о питомце",
  "lang": "ru",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#fff7ec",
  "theme_color": "#fff7ec",
  "categories": ["lifestyle", "health", "utilities"],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./screenshots/desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Главный экран приложения"
    },
    {
      "src": "./screenshots/mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Мобильный интерфейс"
    }
  ],
  "shortcuts": [
    {
      "name": "Открыть напоминания",
      "short_name": "Напоминания",
      "description": "Быстрый переход к списку задач",
      "url": "./?action=reminders",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
